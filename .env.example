# Names only — real values live in Vercel → Project → Settings → Environment Variables.
# For local development run:  vercel env pull .env.local

# Supabase (added by the Vercel ↔ Supabase integration)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=        # used only by `npm run db:migrate`

# Google Cloud — Vertex AI via keyless Workload Identity Federation (Vercel OIDC)
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WIF_POOL_ID=vercel
GCP_WIF_PROVIDER_ID=vercel
